# RescuePath Python Routing Service Environment Configuration
ROUTING_HOST=0.0.0.0
ROUTING_PORT=8000

# Dynamic Reroute Delay Threshold (in minutes)
# Rerouting alert triggers when remaining route delay delta >= threshold
REROUTE_DELAY_THRESHOLD_MINUTES=3.0

# Traffic Provider: "algorithmic", "tomtom", "google", "osrm"
TRAFFIC_PROVIDER=algorithmic

# TomTom Developer API Key
TOMTOM_API_KEY=

# Google Maps API Key
GOOGLE_MAPS_API_KEY=

# OpenStreetMap OSRM Server URL (Public or Self-Hosted)
OSRM_ROUTING_URL=http://router.project-osrm.org
