# RescuePath API Gateway Environment Configuration
PORT=5000
NODE_ENV=development

# Python FastAPI Routing Engine URL
ROUTING_SERVICE_URL=http://localhost:8000

# MongoDB Atlas Connection String
# Optional: If omitted or unreachable, RescuePath automatically activates
# the built-in zero-configuration local persistence store (LocalStore).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rescuepath?retryWrites=true&w=majority

# External Commercial Traffic & Routing API Configuration
# Supported providers: "algorithmic" (default), "tomtom", "google", "osrm"
TRAFFIC_PROVIDER=algorithmic

# TomTom Traffic API Key (Get free key at: https://developer.tomtom.com/)
# Used for real-time traffic flow segments and live speeds
TOMTOM_API_KEY=

# Google Maps API Key (Optional)
# Used for Distance Matrix and Google Routes if enabled
GOOGLE_MAPS_API_KEY=
